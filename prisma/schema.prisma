generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  lookups      Lookup[]
}

model Listing {
  id          String   @id @default(cuid())
  code        String?
  number      String   @unique
  prefix      String
  operator    String   @default("MCI")
  price       BigInt?
  status      String?
  priceType   String?
  sellType    String?
  special     String?
  /// rond.ir algorithm ids (ground-truth labels from the "نوع رند" filter)
  algorithms  String[] @default([])
  patternTags String[]
  source      String   @default("import")
  importedAt  DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  /// Last time a full sync saw this listing on rond.ir
  lastSeenAt  DateTime @default(now())
  /// false once a full sync no longer finds it (sold or removed)
  active      Boolean  @default(true)

  @@index([prefix])
  @@index([code])
  @@index([active, prefix])
}

/// One run of the hourly rond.ir sync worker
model SyncRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// running | ok | failed
  status     String    @default("running")
  withLabels Boolean   @default(false)
  seen       Int       @default(0)
  deactivated Int      @default(0)
  error      String?

  @@index([startedAt])
}

model Lookup {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  number    String
  result    Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
