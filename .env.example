DATABASE_URL="postgresql://user:pass@localhost:5432/rond"
AUTH_SECRET="generate-with: openssl rand -base64 32"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
# Optional: session cookies for live rond.ir ingestion (never commit)
ROND_COOKIE=""
# Hourly sync worker (npm run rond:sync)
ROND_SYNC_INTERVAL_MIN=60
ROND_SYNC_LABELS_HOURS=24
# ROND_SYNC_PRECODES=0912,0919
ROND_SYNC_DELAY=400
# AvalAI (avalai.ir) price suggestions. Never commit the real key.
AVALAI_API_KEY=""
# Tried in order: free models first, then the cheapest (npm run avalai:models)
AVALAI_MODELS="gpt-4.1-nano,gemini-2.0-flash-lite,gpt-4o-mini"
